rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedInWithPassword() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isAdmin() {
      return signedInWithPassword()
        && request.auth.token.adminRole in ['owner', 'moderator']
        && request.auth.token.adminSessionVersion is int
        && firestore.exists(
          /databases/(default)/documents/adminAccounts/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/adminAccounts/$(request.auth.uid)
        ).data.disabled == false
        && firestore.get(
          /databases/(default)/documents/adminAccounts/$(request.auth.uid)
        ).data.role == request.auth.token.adminRole
        && firestore.get(
          /databases/(default)/documents/adminAccounts/$(request.auth.uid)
        ).data.sessionVersion == request.auth.token.adminSessionVersion;
    }

    match /fanart/{path=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
