# Firebase Auth UID allowed to claim the first Owner account.
BOOTSTRAP_OWNER_UID=

# Provision with scripts/provision-public-delivery.mjs. Public readers receive
# storage.objects.get on public-snapshots/ only, with no Firestore permission.
# Dedicated UBLA + public access prevention bucket; legacy media stays in the Firebase default bucket.
PUBLIC_SNAPSHOT_BUCKET=YOUR_PROJECT-public-snapshots
PUBLIC_FEED_SERVICE_ACCOUNT=public-feed-reader@YOUR_PROJECT.iam.gserviceaccount.com
