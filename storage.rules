rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function signedInWithPassword() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isAdmin() {
      return signedInWithPassword()
        && request.auth.token.adminRole in ['owner', 'moderator']
        && request.auth.token.adminSessionVersion is int
        && firestore.exists(
          /databases/(default)/documents/adminAccounts/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/adminAccounts/$(request.auth.uid)
        ).data.disabled == false
        && firestore.get(
          /databases/(default)/documents/adminAccounts/$(request.auth.uid)
        ).data.role == request.auth.token.adminRole
        && firestore.get(
          /databases/(default)/documents/adminAccounts/$(request.auth.uid)
        ).data.sessionVersion == request.auth.token.adminSessionVersion;
    }

    match /fanart/{userId}/{fanartId}/{fileName} {
      allow read: if isAdmin();

      // Legacy objects remain reviewable; new contributions contain X links only.
      allow create, update, delete: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
