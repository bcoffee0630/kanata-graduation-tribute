{
  "hosting": [
    {
      "target": "public",
      "public": ".hosting-public",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/fanart-media",
          "function": { "functionId": "fanartMedia", "region": "asia-east1" }
        }
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/*.json",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/auth/action{,/**}",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
            { "key": "Referrer-Policy", "value": "no-referrer" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
            { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" }
          ]
        }
      ]
    },
    {
      "target": "admin",
      "public": ".hosting-admin",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/fanart-media",
          "function": { "functionId": "fanartMedia", "region": "asia-east1" }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
            { "key": "Referrer-Policy", "value": "no-referrer" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
            { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.googleapis.com https://asia-east1-kanata-memorial.cloudfunctions.net wss://*.firebaseio.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
          ]
        }
      ]
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", ".env*", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
  },
  "storage": { "rules": "storage.rules" },
  "firestore": {
    "database": "(default)",
    "location": "asia-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "hosting": { "host": "127.0.0.1", "port": 5070 }
  }
}
